# systemd unit for psnr. Copy the binary to /usr/local/bin/psnr and this file to /etc/systemd/system/psnr.service,
# put your settings in /etc/psnr/psnr.env (start from re-psn.env.example next to this file), then:
#   systemctl daemon-reload && systemctl enable --now psnr
# If you change a port, change it in your firewall too.
[Unit]
Description=psnr matchmaking server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/psnr
EnvironmentFile=-/etc/psnr/psnr.env
Restart=on-failure
RestartSec=2
DynamicUser=yes
# a log file, if you set RE_PSN_LOG_FILE, belongs under /var/lib/psnr
StateDirectory=psnr
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
