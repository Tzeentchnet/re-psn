# psnr settings. Every flag is also a variable: PSNR_<FLAG>, upper case, dashes as underscores. A flag on the
# command line wins over the variable. Leave a line commented to keep the default shown; a variable that is set
# but empty counts as SET (PSNR_HTTP= turns the status page off). See docs/running.md.
#
# systemd: EnvironmentFile=/etc/psnr/psnr.env   Docker: --env-file psnr.env   Windows: set the variables, then run psnr.exe

# Where game clients connect. -addr sets TCP and UDP together; give either its own with the next two.
#PSNR_ADDR=:36100
#PSNR_TCP_ADDR=
#PSNR_UDP_ADDR=

# Status page and /api/stats. It lists every online ID: keep it on localhost, or set a token if it is not.
#PSNR_HTTP=127.0.0.1:36101
#PSNR_HTTP_TOKEN=

# Limits (0 for no limit)
#PSNR_MAX_ROOMS=1000
#PSNR_MAX_PLAYER_ROOMS=8
#PSNR_MAX_CONNS_PER_ADDR=32
#PSNR_MAX_REQ_RATE=200

# Behind a reverse proxy: list ONLY your own proxies here (CIDRs or addresses, comma-separated), then turn
# PROXY protocol on and have the proxy send it on the game TCP port. A list such as 0.0.0.0/0 trusts everyone.
# UDP is not proxied: publish it straight to this host. See the proxy examples next to this file.
#PSNR_TRUSTED_PROXIES=
#PSNR_PROXY_PROTOCOL=false

# Carry traffic between players who cannot reach each other directly. Uses this server's bandwidth.
#PSNR_RELAY=false

# Logging
#PSNR_LOG_LEVEL=info
#PSNR_LOG_FORMAT=text
#PSNR_LOG_FILE=
#PSNR_V=false
