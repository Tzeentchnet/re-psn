# psnr settings (an example: copy it to re-psn.env, or to /etc/psnr/psnr.env for the systemd unit, and edit; never commit it).
# Every flag is also a variable: RE_PSN_<FLAG>, upper case, dashes as underscores. A flag on the
# command line wins over the variable. Leave a line commented to keep the default shown; a variable that is set
# but empty counts as SET (RE_PSN_HTTP= turns the status page off). See docs/running.md.
#
# systemd: EnvironmentFile=/etc/psnr/psnr.env   Docker: --env-file re-psn.env   Windows: set the variables, then run psnr.exe

# Where game clients connect. -addr sets TCP and UDP together; give either its own with the next two.
#RE_PSN_ADDR=:36100
#RE_PSN_TCP_ADDR=
#RE_PSN_UDP_ADDR=

# Status page and /api/stats. It lists every online ID: keep it on localhost, or set a token if it is not.
#RE_PSN_HTTP=127.0.0.1:36101
#RE_PSN_HTTP_TOKEN=

# Limits (0 for no limit)
#RE_PSN_MAX_ROOMS=1000
#RE_PSN_MAX_PLAYER_ROOMS=8
#RE_PSN_MAX_CONNS_PER_ADDR=32
#RE_PSN_MAX_REQ_RATE=200

# Behind a reverse proxy: list ONLY your own proxies here (CIDRs or addresses, comma-separated), then turn
# PROXY protocol on and have the proxy send it on the game TCP port. A list such as 0.0.0.0/0 trusts everyone.
# UDP is not proxied: publish it straight to this host. See the proxy examples next to this file.
#RE_PSN_TRUSTED_PROXIES=
#RE_PSN_PROXY_PROTOCOL=false

# Accept UDP probes and relay packets from an address other than the player's TCP address. Only for players whose
# UDP leaves from another public address (some multi-WAN or carrier NAT setups); it weakens the check against
# spoofed or stolen-token probes.
#RE_PSN_UDP_ANY_SOURCE=false

# Carry traffic between players who cannot reach each other directly. Uses this server's bandwidth.
#RE_PSN_RELAY=false

# Logging
#RE_PSN_LOG_LEVEL=info
#RE_PSN_LOG_FORMAT=text
#RE_PSN_LOG_FILE=
#RE_PSN_V=false

# --- deprecated names ---
# The old PSNR_<FLAG> names still work when the RE_PSN_ name is not set, and the server logs a
# warning at start naming each one (never its value). If both are set and differ, RE_PSN_ wins, with a warning.
# Rename them when convenient. The old name of each setting above:
#   PSNR_ADDR PSNR_TCP_ADDR PSNR_UDP_ADDR PSNR_HTTP PSNR_HTTP_TOKEN
#   PSNR_MAX_ROOMS PSNR_MAX_PLAYER_ROOMS PSNR_MAX_CONNS_PER_ADDR PSNR_MAX_REQ_RATE
#   PSNR_TRUSTED_PROXIES PSNR_PROXY_PROTOCOL PSNR_UDP_ANY_SOURCE PSNR_RELAY
#   PSNR_LOG_LEVEL PSNR_LOG_FORMAT PSNR_LOG_FILE PSNR_V
# --- end of deprecated names ---
